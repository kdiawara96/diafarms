### APPLICATION ###
APP_NAME=diafarms
APP_PORT=9093
ENVIRONMENT=DOCKER

### POSTGRESQL ###
DATABASE_HOST_NAME=localhost
POSTGRES_PORT=5432
DATABASES_NAME=diafarms_databases
POSTGRES_USER_NAME=diafarms_user
POSTGRES_USER_PASSWORD=change-me

### FICHIERS & SECURITE ###
BASE_URL=http://localhost:8082/diafarms/files/
BASE_PATH=/absolute/path/to/files
SECRET_KEY=change-me
PROFIL_FOLDER=profils

### SECRET QRCODE
AES_SECRET_KEY=change-me

# === MINIO ===
MINIO_URL=http://localhost:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_NAME=diafarms-documents

# === DATABASE ===
DB_URL=jdbc:postgresql://localhost:5432/diafarms
DB_USERNAME=diafarms_databases
DB_PASSWORD=change-me

# === SERVER ===
SERVER_PORT=9093

# === COOKIES (JWT HttpOnly) ===
COOKIE_SECURE=false
COOKIE_DOMAIN=

# === ADMIN PAR DEFAUT (créé automatiquement au premier démarrage s'il n'existe pas) ===
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@example.com
ADMIN_TELEPHONE=
ADMIN_FULLNAME=Super Administrateur

# === MAIL (SMTP - envoi des identifiants à la création de compte) ===
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=change-me
MAIL_PASSWORD=change-me
