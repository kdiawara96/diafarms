# Variables lues DIRECTEMENT depuis un fichier .env par MlApplication (voir
# PropertySourcesPlaceholderConfigurer/loadEnv() dans MlApplication.java) — ce
# mécanisme lit un vrai fichier sur disque, pas les variables d'environnement Docker
# classiques. docker-compose.prod.yml monte ce fichier tel quel dans le conteneur
# (./.env:/app/.env:ro) : copier vers .env sur le serveur : cp .env.prod.example .env
#
# Contrairement à .env (dev local, hôtes "localhost"), les services se joignent ici
# par nom de conteneur sur le réseau bati_network (atelierso_postgres, atelierso-minio)
# — ce sont les conteneurs déjà utilisés par AtelierSo, avec une base et un bucket
# dédiés à Diafarms dedans.

APP_NAME=diafarms
APP_PORT=9093
ENVIRONMENT=PROD

# PostgreSQL (conteneur atelierso_postgres, base/rôle dédiés à Diafarms)
DATABASE_HOST_NAME=atelierso_postgres
POSTGRES_PORT=5432
DATABASES_NAME=diafarms_databases
POSTGRES_USER_NAME=diafarms_user
POSTGRES_USER_PASSWORD=change-me

# MinIO (conteneur atelierso-minio, bucket dédié à Diafarms, pas de port publié sur l'hôte)
MINIO_URL=http://atelierso-minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_NAME=diafarms-documents

# URL publique servie par le reverse proxy du serveur devant diafarms_back (fichiers/QR)
BASE_URL=https://ton-domaine.exemple/diafarms/files/
BASE_PATH=/app/files

# Secrets applicatifs
SECRET_KEY=change-me-use-openssl-rand-hex-32
AES_SECRET_KEY=change-me-32-bytes-base64
PROFIL_FOLDER=profils
COOKIE_SECURE=true
COOKIE_DOMAIN=

# SUPER_ADMIN par défaut : voir super-admin-seed.example.json (JSON séparé, pas ici) —
# exécuté une seule fois, à la toute première mise en route, jamais recréé ensuite.

# Mail (SMTP) — envoi des identifiants à la création de compte
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
