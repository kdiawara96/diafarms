# Variables pour docker-compose.prod.yml — copier vers .env sur le serveur : cp .env.prod.example .env
# Contrairement à .env (dev local), les services se joignent ici par nom de conteneur
# sur le réseau bati_network (atelierso_postgres, atelierso-minio), pas via localhost —
# ce sont les conteneurs déjà utilisés par AtelierSo, avec une base et un bucket dédiés
# à Diafarms dedans (voir DATABASES_NAME/MINIO_BUCKET_NAME ci-dessous).

APP_NAME=diafarms

# PostgreSQL (conteneur atelierso_postgres, base/rôle dédiés à Diafarms)
DATABASES_NAME=diafarms_databases
POSTGRES_USER_NAME=diafarms_user
POSTGRES_USER_PASSWORD=change-me

# MinIO (conteneur atelierso-minio, bucket dédié à Diafarms, pas de port publié sur l'hôte)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET_NAME=diafarms-documents

# URL publique servie par le reverse proxy du serveur devant diafarms_back (fichiers/QR)
BASE_URL=https://ton-domaine.exemple/diafarms/files/

# Secrets applicatifs
SECRET_KEY=change-me-use-openssl-rand-hex-32
AES_SECRET_KEY=change-me-32-bytes-base64
COOKIE_SECURE=true
COOKIE_DOMAIN=

# Admin par défaut (créé automatiquement au premier démarrage s'il n'existe pas)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@diafarms.local
ADMIN_TELEPHONE=00000000
ADMIN_FULLNAME=Super Administrateur

# Mail (SMTP) — envoi des identifiants à la création de compte
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
